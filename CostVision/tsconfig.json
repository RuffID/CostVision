{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "rootDir": "wwwroot/ts",
    "outDir": "wwwroot/dist",
    "allowJs": false,
    "checkJs": false,
    "strict": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true
  },
  "include": [
    "wwwroot/ts/**/*.ts"
  ]
}
