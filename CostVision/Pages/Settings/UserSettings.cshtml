@page
@model CostVision.Web.Pages.Settings.UserSettingsModel
@{
    ViewData["Title"] = "Настройки пользователя";
}

<div class="container my-4" data-user-id="@Model.CurrentUser.Id">
    <h2 class="mb-4">Настройки пользователя</h2>

    <div class="row g-3">
        <!-- Левая колонка: создание счёта -->
        <div class="col-12 col-lg-6">
            <div class="card mb-3">
                <div class="card-header fs-5">
                    Создание счёта
                </div>
                <div class="card-body">
                    <form id="new-account-form" method="post" class="row g-3">
                        <div class="col-12">
                            <div class="mb-2">
                                <label for="account-name" class="form-label">Название счёта</label>
                                <input id="account-name" autocomplete="off" name="Name" type="text" class="form-control" />
                                <div id="account-name-error" class="text-danger small"></div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mb-2">
                                <label for="account-description" class="form-label">Описание</label>
                                <input id="account-description" name="Description" type="text" class="form-control" />
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mb-2">
                                <label class="form-label d-block" for="account-color-input">Цвет счёта</label>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" id="account-color-button" class="btn border rounded-2 p-0 flex-shrink-0" style="width: 2.5rem; height: 2.5rem; background-color: #0D6EFD;" aria-label="Выбрать цвет счёта"></button>
                                    <input id="account-color-input" type="color" class="visually-hidden" value="#0D6EFD" />
                                    <span id="account-color-value" class="small text-muted">#0D6EFD</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-flex align-items-center justify-content-between">
                            <button type="submit" id="create-account-btn" class="btn btn-success">
                                Создать счёт
                            </button>

                            <div id="new-account-error" class="text-danger small"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- правая колонка: список счетов -->
        <div class="col-12 col-lg-6">
            <h5 class="mb-2">Мои счета</h5>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="show-hidden-accounts">
                <label class="form-check-label" for="show-hidden-accounts">
                    Показывать удалённые
                </label>
            </div>

            <div id="accountsListContainer" style="max-height: 600px; overflow-y: auto;">
                <ul class="list-group" id="accountsList">
                    <!-- элементы загружаются из JS -->
                </ul>

                <div id="accounts-empty" class="text-muted small p-3 d-none">
                    Счета пока не созданы.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно редактирования счёта -->
<div class="modal fade" id="account-modal" tabindex="-1" aria-labelledby="accountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="accountModalLabel">Редактирование счёта</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="modal-account-id" />

                <div class="mb-3">
                    <label for="modal-account-name" class="form-label">Название счёта</label>
                    <input type="text" id="modal-account-name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="modal-account-description" class="form-label">Описание</label>
                    <input type="text" id="modal-account-description" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label d-block" for="modal-account-color-input">Цвет счёта</label>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" id="modal-account-color-button" class="btn border rounded-2 p-0 flex-shrink-0" style="width: 2.5rem; height: 2.5rem; background-color: #0D6EFD;" aria-label="Выбрать цвет счёта"></button>
                        <input id="modal-account-color-input" type="color" class="visually-hidden" value="#0D6EFD" />
                        <span id="modal-account-color-value" class="small text-muted">#0D6EFD</span>
                    </div>
                </div>

                <div id="modal-account-error" class="text-danger small mt-2"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="modal-cancel-btn" data-bs-dismiss="modal">
                    Отмена
                </button>

                <button type="button" class="btn btn-outline-secondary" id="modal-share-btn">
                    Поделиться
                </button>

                <button type="button" class="btn btn-primary" id="modal-save-btn">
                    Сохранить
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="account-share-modal" tabindex="-1" aria-labelledby="accountShareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="accountShareModalLabel">Доступ к счёту</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="share-account-id" name="share-account-id" />

                <div id="account-share-error" class="text-danger small mb-3"></div>

                <div class="small text-muted mb-3">
                    Роль «Только просмотр» разрешает только просмотр счёта, а «Редактирование» позволяет добавлять в него чеки.
                </div>

                <div id="account-share-users" class="d-flex flex-column gap-2"></div>

                <div id="account-share-empty" class="text-muted small d-none">
                    Нет пользователей, которым можно предоставить доступ.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Отмена
                </button>

                <button type="button" class="btn btn-primary" id="account-share-save-btn">
                    Сохранить доступ
                </button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/dist/pages/settings/userSettings/index.js" asp-append-version="true"></script>
