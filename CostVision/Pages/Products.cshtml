@page "/products"
@model CostVision.Web.Pages.ProductsModel

@{
    ViewData["Title"] = "Товары";
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Товары</h2>
    </div>

    <div id="productsAlert" class="alert alert-warning d-none" role="alert"></div>

    <div class="border rounded-3 p-3 mb-3">
        <div class="row g-2">
            <div class="col-12">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg">
                        <label for="productsSearch" class="form-label mb-1">Поиск</label>
                        <input type="text" id="productsSearch" name="productsSearch" class="form-control" placeholder="Название или адаптивное название..." autocomplete="off">
                    </div>

                    <div class="col-12 col-md-auto">
                        <button type="button" id="productsApplyFilter" class="btn btn-outline-primary w-100">Найти</button>
                    </div>
                </div>

                <div class="form-check mt-2">
                    <input type="checkbox" id="productsUseAdaptiveNames" name="productsUseAdaptiveNames" class="form-check-input">
                    <label for="productsUseAdaptiveNames" class="form-check-label">Включить адапт. названия</label>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 flex-grow-1" data-products-pagination></div>
        <div class="ms-auto">
            <label for="productsTopPageSize" class="form-label mb-1">На странице</label>
            <select id="productsTopPageSize" name="productsTopPageSize" class="form-select">
                <option value="20">20</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Название</th>
                    <th scope="col" id="productsAdaptiveNameHeader" class="text-nowrap d-none" style="width: 22rem;">Адаптивное название</th>
                    <th scope="col" id="productsActionsHeader" class="text-center d-none" style="width: 9rem;">Действия</th>
                </tr>
            </thead>
            <tbody id="productsTableBody"></tbody>
        </table>
    </div>

    <div class="d-flex flex-column align-items-center gap-1 mt-2">
        <div class="fs-5" data-products-page-info></div>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2" data-products-pagination></div>
    </div>
</div>

<script type="module" src="~/dist/pages/products/index.js" asp-append-version="true"></script>
