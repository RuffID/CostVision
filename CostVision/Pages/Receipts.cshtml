@page
@model CostVision.Web.Pages.ReceiptsModel

@{
    ViewData["Title"] = "Список чеков";
}

<div class="container py-3">
    <h2 class="mb-3">Список чеков</h2>

    <div class="row g-2 mb-3 align-items-end">
        <div class="col-auto">
            <label for="receiptPeriodPreset" class="form-label mb-1">Период</label>
            <select id="receiptPeriodPreset" name="receiptPeriodPreset" class="form-select">
                <option value="currentDay">Текущий день</option>
                <option value="currentWeek">Текущая неделя</option>
                <option value="currentMonth" selected>Текущий месяц</option>
                <option value="currentYear">Текущий год</option>
            </select>
        </div>

        <div class="col-auto">
            <label for="dateFrom" class="form-label mb-1">с</label>
            <input type="date" id="dateFrom" name="dateFrom" class="form-control" autocomplete="off">
        </div>

        <div class="col-auto">
            <label for="dateTo" class="form-label mb-1">по</label>
            <input type="date" id="dateTo" name="dateTo" class="form-control" autocomplete="off">
        </div>

        <div class="col-12 col-md-4 col-lg-3">
            <label for="receiptAccountFilter" class="form-label mb-1">Счёт</label>
            <select id="receiptAccountFilter" name="receiptAccountFilter" class="form-select" disabled>
                <option value="">Загрузка счетов...</option>
            </select>
            <div id="receiptAccountFilterError" class="text-danger small mt-2 d-none"></div>
        </div>

        <div class="col-auto">
            <button type="button" id="applyFilter" class="btn btn-sm btn-primary">Показать</button>
        </div>

        <div class="col"></div>

        <div class="col-12 col-xl-7">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg">
                    <label for="receiptSearch" class="form-label mb-1">Поиск</label>
                    <input type="text" id="receiptSearch" name="receiptSearch" class="form-control" placeholder="Введите запрос..." autocomplete="off">
                </div>

                <div class="col-12 col-sm-5 col-lg-4">
                    <label for="receiptSearchMode" class="form-label mb-1">Искать по</label>
                    <select id="receiptSearchMode" name="receiptSearchMode" class="form-select">
                        <option value="all" selected>Все</option>
                        <option value="sum">Сумма</option>
                        <option value="shop">Магазин</option>
                        <option value="fn">ФН</option>
                        <option value="fd">ФД</option>
                        <option value="fp">ФП</option>
                    </select>
                </div>

                <div class="col-12 col-lg-auto">
                    <div class="d-flex flex-wrap gap-2">
                        <span id="receiptsCount" class="input-group-text">Чеков: 0</span>
                        <span id="receiptsSum" class="input-group-text">Сумма: 0 ₽</span>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="receipt-list" class="d-flex flex-column gap-2">
        <!-- Элементы будут добавляться через JS -->
    </div>
</div>

<!-- Модальное окно деталей чека -->
<div class="modal fade" id="receiptDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Детали чека</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="receipt-details-header" class="mb-2"></div>
                <div id="receipt-details-list" class="d-flex flex-column gap-2"></div>
            </div>
            <div class="modal-footer">
                <span id="receipt-details-total" class="me-auto fw-semibold"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно переноса чека между счетами -->
<div class="modal fade" id="moveReceiptAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Изменение счёта чека</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="moveReceiptAccountAlert" class="alert alert-warning d-none mb-3" role="alert"></div>
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-5">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="form-label d-block mb-2">Откуда переносим</div>
                            <div id="moveReceiptSourceAccount" class="px-3 py-2 rounded-pill d-inline-flex align-items-center fw-semibold"></div>
                        </div>
                    </div>
                    <div class="col-12 col-md-2 text-center">
                        <div class="display-6 fw-semibold text-primary" aria-hidden="true">→</div>
                    </div>
                    <div class="col-12 col-md-5">
                        <div class="border rounded-3 p-3 h-100">
                            <label for="moveReceiptTargetAccount" class="form-label d-block mb-2">Куда переносим</label>
                            <select id="moveReceiptTargetAccount" name="moveReceiptTargetAccount" class="form-select"></select>
                        </div>
                    </div>
                </div>
                <div class="small text-muted mt-3">
                    Перенос недоступен, если чек уже есть в выбранном счёте назначения или у Вас нет прав на изменение этого счёта.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="removeReceiptFromAccountBtn" class="btn btn-outline-danger">Удалить из счёта</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" id="confirmMoveReceiptAccountBtn" class="btn btn-primary">Перенести чек</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления чека -->
<div class="modal fade" id="deleteReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteReceiptModalTitle">Удаление чека</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2" id="deleteReceiptModalMessage">
                    Вы уверены, что хотите удалить этот чек?
                </p>
                <div class="text-muted" id="deleteReceiptModalReceiptInfo"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteReceiptBtn">
                    Удалить
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/helpers/http.js" asp-append-version="true"></script>
<script src="~/js/helpers/verificationToken.js" asp-append-version="true"></script>
<script src="~/js/reports/receipts.js" asp-append-version="true"></script>
