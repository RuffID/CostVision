@page "/stores"
@model CostVision.Web.Pages.StoresModel

@{
    ViewData["Title"] = "Магазины";
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Магазины</h2>
    </div>

    <div id="storesAlert" class="alert alert-warning d-none" role="alert"></div>

    <div class="border rounded-3 p-3 mb-3">
        <div class="row g-2">
            <div class="col-12">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg">
                        <label for="storesSearch" class="form-label mb-1">Поиск</label>
                        <input type="text" id="storesSearch" name="storesSearch" class="form-control" placeholder="Название, адрес или адаптивное название..." autocomplete="off">
                    </div>

                    <div class="col-12 col-md-auto">
                        <button type="button" id="storesApplyFilter" class="btn btn-outline-primary w-100">Найти</button>
                    </div>
                </div>

                <div class="form-check mt-2">
                    <input type="checkbox" id="storesUseAdaptiveNames" name="storesUseAdaptiveNames" class="form-check-input">
                    <label for="storesUseAdaptiveNames" class="form-check-label">Включить адаптивное названия</label>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 flex-grow-1" data-stores-pagination></div>
        <div class="ms-auto">
            <label for="storesTopPageSize" class="form-label mb-1">На странице</label>
            <select id="storesTopPageSize" name="storesTopPageSize" class="form-select">
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="border-0 bg-transparent p-0" style="width: 2.5rem;"></th>
                    <th scope="col" class="border-start border-bottom">
                        <button type="button" id="storesNameSortButton" class="btn btn-link p-0 text-decoration-none text-body fw-semibold">Наименование ↑</button>
                    </th>
                    <th scope="col" class="border-start border-bottom">Адрес</th>
                    <th scope="col" class="border-start border-end border-bottom text-nowrap" style="width: 9rem;">
                        <button type="button" id="storesReceiptCountSortButton" class="btn btn-link p-0 text-decoration-none text-body fw-semibold">Количество</button>
                        <span id="storesReceiptCountHelp" data-help-tooltip-host></span>
                    </th>
                    <th scope="col" id="storesAdaptiveNameHeader" class="border-start border-bottom text-nowrap d-none" style="width: 22rem;">Адаптивное название</th>
                    <th scope="col" id="storesActionsHeader" class="border-start border-end border-bottom text-center d-none" style="width: 9rem;">Действия</th>
                </tr>
            </thead>
            <tbody id="storesTableBody"></tbody>
        </table>
    </div>

    <div class="d-flex flex-column align-items-center gap-1 mt-2">
        <div class="fs-5" data-stores-page-info></div>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2" data-stores-pagination></div>
    </div>
</div>

<div class="modal fade" id="storeReceiptsModal" tabindex="-1" aria-labelledby="storeReceiptsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="storeReceiptsModalLabel">Чеки магазина</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="storeReceiptsAlert" class="alert alert-warning d-none mb-3" role="alert"></div>
                <div id="storeReceiptsList" class="d-flex flex-column gap-2"></div>
                <div id="storeReceiptsPagination" class="d-flex flex-wrap justify-content-center align-items-center gap-2 mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="receiptMoneyMovementsModal" tabindex="-1" aria-labelledby="receiptMoneyMovementsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="receiptMoneyMovementsModalLabel">Операции чека</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="receiptMoneyMovementsAlert" class="alert alert-warning d-none mb-3" role="alert"></div>
                <div id="receiptMoneyMovementsInfo" class="mb-1"></div>
                <div class="text-muted small mb-3">Выберите подходящую операцию из списка ниже или измените фильтры поиска.</div>

                <div class="border rounded-3 p-3 mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <label for="receiptMoneyMovementsDateFrom" class="form-label mb-1">с</label>
                            <input type="date" id="receiptMoneyMovementsDateFrom" name="receiptMoneyMovementsDateFrom" class="form-control" autocomplete="off">
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="receiptMoneyMovementsDateTo" class="form-label mb-1">по</label>
                            <input type="date" id="receiptMoneyMovementsDateTo" name="receiptMoneyMovementsDateTo" class="form-control" autocomplete="off">
                        </div>
                        <div class="col-12 col-md-2">
                            <label for="receiptMoneyMovementsAmountTolerance" class="form-label mb-1">
                                Допуск суммы (₽)
                                <span id="receiptMoneyMovementsAmountToleranceHelp" data-help-tooltip-host></span>
                            </label>
                            <input type="number" step="0.01" min="0" id="receiptMoneyMovementsAmountTolerance" name="receiptMoneyMovementsAmountTolerance" class="form-control" value="1" autocomplete="off">
                        </div>
                        <div class="col-12 col-md-2" style="min-width: 12.5rem;">
                            <label for="receiptMoneyMovementsTimeWindowHours" class="form-label mb-1">
                                Допуск времени (час)
                                <span id="receiptMoneyMovementsTimeWindowHoursHelp" data-help-tooltip-host></span>
                            </label>
                            <input type="number" step="0.25" min="0" id="receiptMoneyMovementsTimeWindowHours" name="receiptMoneyMovementsTimeWindowHours" class="form-control" value="1" autocomplete="off">
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input type="checkbox" id="receiptMoneyMovementsUseTimeWindow" name="receiptMoneyMovementsUseTimeWindow" class="form-check-input">
                                    <label for="receiptMoneyMovementsUseTimeWindow" class="form-check-label">
                                        Окно времени
                                        <span id="receiptMoneyMovementsUseTimeWindowHelp" data-help-tooltip-host></span>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input type="checkbox" id="receiptMoneyMovementsUseAmountFilter" name="receiptMoneyMovementsUseAmountFilter" class="form-check-input" checked>
                                    <label for="receiptMoneyMovementsUseAmountFilter" class="form-check-label">
                                        По сумме
                                        <span id="receiptMoneyMovementsUseAmountFilterHelp" data-help-tooltip-host></span>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input type="checkbox" id="receiptMoneyMovementsExcludeLinked" name="receiptMoneyMovementsExcludeLinked" class="form-check-input" checked>
                                    <label for="receiptMoneyMovementsExcludeLinked" class="form-check-label">
                                        Без привязанных
                                        <span id="receiptMoneyMovementsExcludeLinkedHelp" data-help-tooltip-host></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <button type="button" id="receiptMoneyMovementsReloadCandidatesButton" class="btn btn-outline-primary">Найти операции</button>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-5">
                        <h6>Привязанные операции</h6>
                        <div id="receiptLinkedMoneyMovements" class="d-flex flex-column gap-2"></div>
                    </div>
                    <div class="col-12 col-lg-7">
                        <h6>Доступные операции для привязки</h6>
                        <div id="receiptMoneyMovementCandidates" class="d-flex flex-column gap-2"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="receiptDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Детали чека</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="receipt-details-header" class="mb-2"></div>
                <div id="receipt-details-list" class="d-flex flex-column gap-2"></div>
            </div>
            <div class="modal-footer">
                <span id="receipt-details-total" class="me-auto fw-semibold"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="moveReceiptAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Изменение счёта чека</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="moveReceiptAccountAlert" class="alert alert-warning d-none mb-3" role="alert"></div>
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-5">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="form-label d-block mb-2">Откуда переносим</div>
                            <div id="moveReceiptSourceAccount" class="px-3 py-2 rounded-pill d-inline-flex align-items-center fw-semibold"></div>
                        </div>
                    </div>
                    <div class="col-12 col-md-2 text-center">
                        <div class="display-6 fw-semibold text-primary" aria-hidden="true">→</div>
                    </div>
                    <div class="col-12 col-md-5">
                        <div class="border rounded-3 p-3 h-100">
                            <label for="moveReceiptTargetAccount" class="form-label d-block mb-2">Куда переносим</label>
                            <select id="moveReceiptTargetAccount" name="moveReceiptTargetAccount" class="form-select"></select>
                        </div>
                    </div>
                </div>
                <div class="small text-muted mt-3">
                    Перенос недоступен, если чек уже есть в выбранном счёте назначения или у Вас нет прав на изменение этого счёта.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="removeReceiptFromAccountBtn" class="btn btn-outline-danger">Удалить из счёта</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" id="confirmMoveReceiptAccountBtn" class="btn btn-primary">Перенести чек</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="removeReceiptAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="removeReceiptAccountModalTitle">Удаление чека из счёта</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2" id="removeReceiptAccountModalMessage">
                    Вы уверены, что хотите удалить этот чек из счёта?
                </p>
                <div class="text-muted" id="removeReceiptAccountModalReceiptInfo"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmRemoveReceiptAccountBtn">
                    Удалить
                </button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/dist/pages/stores/index.js" asp-append-version="true"></script>
