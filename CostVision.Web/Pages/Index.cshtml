@page
@model IndexModel
@{
    ViewData["Title"] = "Дашборд";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column gap-4">
        <section class="w-100">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-3">
                <div>
                    <h1 class="h3 mb-1">Дашборд</h1>
                    <div class="text-muted">Доходы и расходы</div>
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-12 col-sm-auto">
                        <label for="dashboardIncomeExpensePeriodPreset" class="form-label mb-1">Период</label>
                        <select id="dashboardIncomeExpensePeriodPreset" name="dashboardIncomeExpensePeriodPreset" class="form-select">
                            <option value="previousDay">Вчера</option>
                            <option value="currentDay">Текущий день</option>
                            <option value="previousWeek">Прошлая неделя</option>
                            <option value="currentWeek">Текущая неделя</option>
                            <option value="previousMonth">Прошлый месяц</option>
                            <option value="currentMonth">Текущий месяц</option>
                            <option value="currentYear" selected>Текущий год</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-auto">
                        <label for="dashboardIncomeExpensePeriod" class="form-label mb-1">Группировка</label>
                        <select id="dashboardIncomeExpensePeriod" name="dashboardIncomeExpensePeriod" class="form-select">
                            <option value="day">По дням</option>
                            <option value="month" selected>По месяцам</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-auto">
                        <div class="d-flex align-items-center mb-1">
                            <label for="dashboardIncomeExpenseExpenseSource" class="form-label mb-0">Расходы</label>
                            <span id="dashboardExpenseSourceHelp" data-help-tooltip-host></span>
                        </div>
                        <select id="dashboardIncomeExpenseExpenseSource" name="dashboardIncomeExpenseExpenseSource" class="form-select">
                            <option value="receipts">Чеки</option>
                            <option value="moneyMovements">Операции</option>
                            <option value="receiptsAndMoneyMovements" selected>Чеки и операции</option>
                        </select>
                    </div>

                    <div class="col-6 col-sm-auto">
                        <label for="dashboardIncomeExpenseDateFrom" class="form-label mb-1">с</label>
                        <input type="date" id="dashboardIncomeExpenseDateFrom" name="dashboardIncomeExpenseDateFrom" class="form-control" autocomplete="off">
                    </div>

                    <div class="col-6 col-sm-auto">
                        <label for="dashboardIncomeExpenseDateTo" class="form-label mb-1">по</label>
                        <input type="date" id="dashboardIncomeExpenseDateTo" name="dashboardIncomeExpenseDateTo" class="form-control" autocomplete="off">
                    </div>
                </div>
            </div>

            <div class="border rounded-3 p-3 w-100">
                <div class="d-flex flex-column flex-xl-row gap-3 justify-content-between align-items-xl-start mb-3">
                    <div id="dashboardIncomeExpenseSummary" class="d-flex flex-wrap gap-2"></div>

                    <div class="d-flex flex-column flex-md-row gap-2">
                        <div class="dropdown" style="min-width: 18rem;">
                            <button type="button" id="dashboardAccountFilterButton" class="btn btn-outline-secondary dropdown-toggle w-100 text-start" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                Счёт
                            </button>
                            <div class="dropdown-menu p-3 w-100" aria-labelledby="dashboardAccountFilterButton">
                                <div id="dashboardAccountFilterList" class="d-flex flex-column gap-2 overflow-auto" style="max-height: 16rem;"></div>
                            </div>
                        </div>

                        <div class="dropdown" style="min-width: 18rem;">
                            <button type="button" id="dashboardStoreFilterButton" class="btn btn-outline-secondary dropdown-toggle w-100 text-start" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                Магазины
                            </button>
                            <div class="dropdown-menu p-3 w-100" aria-labelledby="dashboardStoreFilterButton">
                                <label for="dashboardStoreSearch" class="form-label mb-1">Поиск</label>
                                <input type="search" id="dashboardStoreSearch" name="dashboardStoreSearch" class="form-control mb-2" autocomplete="off">
                                <div id="dashboardStoreFilterList" class="d-flex flex-column gap-2 overflow-auto" style="max-height: 16rem;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="dashboardIncomeExpenseError" class="alert alert-warning d-none" role="alert"></div>

                <div class="position-relative w-100" style="height: 28rem;">
                    <canvas id="dashboardIncomeExpenseChart"></canvas>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script type="module" src="~/dist/pages/dashboard/index.js" asp-append-version="true"></script>
}
