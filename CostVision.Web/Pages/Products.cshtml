@page "/products"
@model CostVision.Web.Pages.ProductsModel

@{
    ViewData["Title"] = "Товары";
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Товары</h2>
    </div>

    <div id="productsAlert" class="alert alert-warning d-none" role="alert"></div>

    <div class="border rounded-3 p-3 mb-3">
        <div class="row g-2">
            <div class="col-12">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg">
                        <label for="productsSearch" class="form-label mb-1">Поиск</label>
                        <input type="text" id="productsSearch" name="productsSearch" class="form-control" placeholder="Название или Ваше наименование..." autocomplete="off">
                    </div>

                    <div class="col-12 col-md-auto">
                        <button type="button" id="productsApplyFilter" class="btn btn-outline-primary w-100">Найти</button>
                    </div>
                </div>

                <div class="form-check mt-2">
                    <input type="checkbox" id="productsShowOriginalNames" name="productsShowOriginalNames" class="form-check-input">
                    <label for="productsShowOriginalNames" class="form-check-label">Отображать оригинальные названия</label>
                    <span id="productsShowOriginalNamesHelp" data-help-tooltip-host></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <div>
            <label for="productsTopPageSize" class="form-label mb-1">На странице</label>
            <select id="productsTopPageSize" name="productsTopPageSize" class="form-select">
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    <div id="productsTableContainer" class="table-responsive" data-products-table-container>
        <table class="table table-bordered table-hover align-middle mb-0" data-table-loading-content>
            <thead class="table-light">
                <tr>
                    <th scope="col">
                        <button type="button" id="productsNameSortButton" class="btn btn-link p-0 text-decoration-none text-body fw-semibold">Наименование ↑</button>
                        <span id="productsNameHelp" data-help-tooltip-host></span>
                    </th>
                    <th scope="col" class="text-nowrap" style="width: 9rem;">
                        <button type="button" id="productsReceiptCountSortButton" class="btn btn-link p-0 text-decoration-none text-body fw-semibold">Количество</button>
                        <span id="productsReceiptCountHelp" data-help-tooltip-host></span>
                    </th>
                </tr>
            </thead>
            <tbody id="productsTableBody"></tbody>
        </table>
    </div>

    <div class="d-flex flex-column align-items-center gap-1 mt-2">
        <div class="fs-5" data-products-page-info></div>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2" data-products-pagination></div>
    </div>
</div>

<div class="modal fade" id="productStorePurchasesModal" tabindex="-1" aria-labelledby="productStorePurchasesModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productStorePurchasesModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Магазин</th>
                                <th scope="col" class="text-center text-nowrap">Количество</th>
                                <th scope="col" class="text-end text-nowrap">
                                    Средняя цена
                                    <span id="productStorePurchasesPriceHelp" data-help-tooltip-host></span>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="productStorePurchasesBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productAdaptiveNameModal" tabindex="-1" aria-labelledby="productAdaptiveNameModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productAdaptiveNameModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form id="productAdaptiveNameForm" name="productAdaptiveNameForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="productOriginalName" class="form-label">Оригинальное наименование</label>
                        <input type="text" id="productOriginalName" name="productOriginalName" class="form-control" readonly>
                    </div>
                    <div>
                        <label for="productAdaptiveName" class="form-label">Ваше наименование</label>
                        <div class="input-group">
                            <input type="text" id="productAdaptiveName" name="productAdaptiveName" class="form-control" maxlength="500" autocomplete="off">
                            <button type="button" id="productClearAdaptiveName" class="btn btn-outline-secondary d-none">Очистить</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" id="productSaveAdaptiveName" class="btn btn-success">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="module" src="~/dist/pages/products/index.js" asp-append-version="true"></script>
